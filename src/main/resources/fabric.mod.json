{
  "schemaVersion": 1,
  "id": "trainers_workshop",
  "version": "${version}",
  "name": "Trainer's Workshop",
  "description": "Tools for Cobblemon trainers and server admins: Shiny Berry, PokeEditor and Trainer Editor.",
  "authors": [
    "Bubi274"
  ],
  "license": "All-Rights-Reserved",
  "icon": "assets/trainers_workshop/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.github.bubi274.trainersworkshop.TrainersWorkshop"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "io.github.bubi274.trainersworkshop.client.TrainersWorkshopClient"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.6",
    "cobblemon": ">=1.7.3"
  },
  "suggests": {
    "cobblemonraiddens": "*",
    "rctmod": "*",
    "tmcraft": "*",
    "obc": "*"
  },
  "mixins": [
    "trainers_workshop.mixins.json"
  ]
}
